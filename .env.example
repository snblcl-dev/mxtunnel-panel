# Base de datos SQLite
DATABASE_URL="file:./dev.db"

# Puerto del servidor
PORT=3000

# JWT (CAMBIAR en producción)
JWT_SECRET_KEY="change-me-mxtunnel-secret-key"
JWT_SECRET_REFRESH="change-me-mxtunnel-refresh-secret"

# CSRF
CSRF_SECRET="change-me-mxtunnel-csrf-secret"

# CORS (opcional): orígenes permitidos separados por coma. Vacío = CORS desactivado.
# Ejemplo: CORS_ALLOWED_ORIGINS="https://panel.tudominio.com"
CORS_ALLOWED_ORIGINS=""

# Prefijo del proxy para envolver la URL de CheckUser que recibe la app.
# Vacío = se entrega la URL tal cual. Ej: https://mxtunnel.pro/proxy/?url=
PROXY_PREFIX=""

# Datos del admin inicial (solo los usa el seed)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@mxtunnel.local"
ADMIN_PASSWORD="admin123"
