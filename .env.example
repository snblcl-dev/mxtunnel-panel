# Base de datos SQLite
DATABASE_URL="file:./dev.db"

# Puerto del servidor
PORT=3000

# JWT (CAMBIAR en producción)
JWT_SECRET_KEY="change-me-mxtunnel-secret-key"
JWT_SECRET_REFRESH="change-me-mxtunnel-refresh-secret"

# CSRF
CSRF_SECRET="change-me-mxtunnel-csrf-secret"

# CORS (opcional): orígenes permitidos separados por coma. Vacío = CORS desactivado.
# Ejemplo: CORS_ALLOWED_ORIGINS="https://panel.tudominio.com"
CORS_ALLOWED_ORIGINS=""

# Prefijo del proxy para envolver la URL de CheckUser que recibe la app.
# Vacío = se entrega la URL tal cual. Ej: https://mxtunnel.pro/proxy/?url=
PROXY_PREFIX=""

# Datos del admin inicial (solo los usa el seed)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@mxtunnel.local"
ADMIN_PASSWORD="admin123"

# ── Canal config/tema de VpnApp ───────────────────────────────────────────
# APP_CRYPTO_KEY: master SERVER-ONLY. De él se derivan authKey (firma HMAC) y
# encKey (envelope de /api/config) POR USUARIO. NUNCA viaja en la APK.
APP_CRYPTO_KEY="change-me-generar-con-openssl-rand-base64-32"
CONFIG_CRYPTO_ENABLED=true

# ── Generador de APKs (repack de la base VpnApp) ──────────────────────────
# APK_TOKEN_KEY: master del token.enc (igual al MASTER_KEY dentro de TokenCipher).
# APP_WRAP_KEY:  envuelve pkey.enc; DEBE ser la misma clave embebida en el .so
#                vpnsec de la base (hoy: wor/pYLH6RgaQlhzKHyvfzoU1cGKulzJsSG56DoCa+0=).
# APK_BASE:      ruta a la release unsigned de VpnApp en el servidor.
# APK_KEYSTORE / APK_KS_PASS / APK_KS_ALIAS: keystore de firma (vpnapp_debug.jks,
#                pass/alias "vpnapp"). APK_OUTPUT_DIR: carpeta de APKs generadas.
# APKTOOL_JAR / SDK_BUILD_TOOLS: herramientas del repack.
APK_TOKEN_KEY="change-me-master-token"
APP_WRAP_KEY="change-me-master-wrap"
APK_BASE="/ruta/secrets/vpnapp-release-unsigned.apk"
APK_KEYSTORE="/ruta/secrets/vpnapp_debug.jks"
APK_KS_PASS="vpnapp"
APK_KS_ALIAS="vpnapp"
APK_OUTPUT_DIR="/ruta/uploads/apk"
# APKTOOL_JAR=""
# SDK_BUILD_TOOLS=""
