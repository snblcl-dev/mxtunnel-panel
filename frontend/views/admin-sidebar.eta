<aside class="app-sidebar">
  <button type="button" class="btn-close-sidebar" aria-label="Cerrar menú"><i class="bi bi-x-lg"></i></button>
  <div class="brand">
    <span class="brand-mark"><i class="bi bi-shield-lock-fill"></i></span>
    <span>MXTunnel</span>
    <span class="badge bg-primary ms-1">Admin</span>
  </div>
  <div class="user-tag"><%= it.user ? it.user.username : '' %></div>

  <ul class="nav nav-pills flex-column mb-auto">
    <li class="nav-item">
      <a href="/" class="nav-link <%= it.active === 'home' ? 'active' : '' %>">
        <i class="bi bi-house-door"></i><span>Inicio</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/admin/users" class="nav-link <%= it.active === 'users' ? 'active' : '' %>">
        <i class="bi bi-people"></i><span>Usuarios</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/admin/app" class="nav-link <%= it.active === 'app' ? 'active' : '' %>">
        <i class="bi bi-phone"></i><span>Aplicación</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/admin/apk" class="nav-link <%= it.active === 'apk' ? 'active' : '' %>">
        <i class="bi bi-stars"></i><span>Generar APK</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/admin/settings" class="nav-link <%= it.active === 'settings' ? 'active' : '' %>">
        <i class="bi bi-gear"></i><span>Ajustes</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/admin/profile" class="nav-link <%= it.active === 'profile' ? 'active' : '' %>">
        <i class="bi bi-person"></i><span>Perfil</span>
      </a>
    </li>
  </ul>

  <div class="sidebar-footer">
    <form method="POST" action="/logout" class="m-0">
      <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
      <button class="btn btn-secondary w-100" type="submit">
        <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
      </button>
    </form>
  </div>
</aside>
