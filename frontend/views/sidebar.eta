<aside class="app-sidebar">
  <button type="button" class="btn-close-sidebar" aria-label="Cerrar menú"><i class="bi bi-x-lg"></i></button>
  <div class="brand">
    <span class="brand-mark"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5.3 7.7V5.4a2.7 2.7 0 0 1 5.4 0v2.3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M4.8 7.4H11.2a1.9 1.9 0 0 1 1.9 1.9v3.6a1.9 1.9 0 0 1-1.9 1.9H4.8a1.9 1.9 0 0 1-1.9-1.9V9.3a1.9 1.9 0 0 1 1.9-1.9Z" fill="currentColor"/><circle cx="8" cy="10.4" r="1.3" style="fill:var(--bg-3)"/><path d="M7.45 11.55a0.55 0.55 0 0 1 1.1 0v1.45a0.55 0.55 0 0 1-1.1 0Z" style="fill:var(--bg-3)"/></svg></span>
    <span>MXTunnel</span>
  </div>
  <div class="user-tag"><%= it.user ? it.user.username : '' %></div>

  <ul class="nav nav-pills flex-column mb-auto">
    <li class="nav-item">
      <a href="/user" class="nav-link <%= it.active === 'home' ? 'active' : '' %>">
        <i class="bi bi-house-door"></i><span>Inicio</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/user/categories" class="nav-link <%= it.active === 'categories' ? 'active' : '' %>">
        <i class="bi bi-folder"></i><span>Categorías</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/user/servers" class="nav-link <%= it.active === 'servers' ? 'active' : '' %>">
        <i class="bi bi-hdd-rack"></i><span>Servidores</span>
      </a>
    </li>
    <li class="nav-item nav-group <%= (it.active === 'app-settings' || it.active === 'app-themes') ? 'open' : '' %>">
      <button type="button" class="nav-link nav-group-toggle <%= (it.active === 'app-settings' || it.active === 'app-themes') ? 'active' : '' %>">
        <i class="bi bi-phone"></i><span>Aplicación</span>
        <i class="bi bi-chevron-down nav-caret"></i>
      </button>
      <ul class="nav-submenu">
        <li>
          <a href="/user/app" class="nav-link <%= it.active === 'app-settings' ? 'active' : '' %>">
            <i class="bi bi-sliders"></i><span>Ajustes app</span>
          </a>
        </li>
        <li>
          <a href="/user/app/themes" class="nav-link <%= it.active === 'app-themes' ? 'active' : '' %>">
            <i class="bi bi-palette"></i><span>Temas</span>
          </a>
        </li>
      </ul>
    </li>
    <li class="nav-item">
      <a href="/user/community" class="nav-link <%= it.active === 'community' ? 'active' : '' %>">
        <i class="bi bi-people"></i><span>Comunidad</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/user/apk" class="nav-link <%= it.active === 'apk' ? 'active' : '' %>">
        <i class="bi bi-stars"></i><span>Generar APK</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/user/profile" class="nav-link <%= it.active === 'profile' ? 'active' : '' %>">
        <i class="bi bi-person"></i><span>Perfil</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="https://t.me/LuxAetr" target="_blank" rel="noopener" class="nav-link">
        <i class="bi bi-send"></i><span>Contacto y soporte</span>
        <i class="bi bi-box-arrow-up-right nav-ext"></i>
      </a>
    </li>
  </ul>

  <div class="sidebar-footer">
    <form method="POST" action="/logout" class="m-0">
      <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
      <button class="btn btn-secondary w-100" type="submit">
        <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
      </button>
    </form>
  </div>
</aside>
