<aside class="app-sidebar">
  <div class="brand">
    <i class="bi bi-shield-lock-fill"></i>
    <span>MXTunnel</span>
  </div>
  <div class="user-tag"><%= it.user ? it.user.username : '' %></div>

  <ul class="nav nav-pills flex-column mb-auto">
    <li class="nav-item">
      <a href="/user" class="nav-link <%= it.active === 'home' ? 'active' : '' %>">
        <i class="bi bi-house-door"></i><span>Inicio</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/user/categories" class="nav-link <%= it.active === 'categories' ? 'active' : '' %>">
        <i class="bi bi-folder"></i><span>Categorías</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/user/servers" class="nav-link <%= it.active === 'servers' ? 'active' : '' %>">
        <i class="bi bi-hdd-rack"></i><span>Servidores</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/user/app" class="nav-link <%= it.active === 'app' ? 'active' : '' %>">
        <i class="bi bi-phone"></i><span>Aplicación</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/user/profile" class="nav-link <%= it.active === 'profile' ? 'active' : '' %>">
        <i class="bi bi-person"></i><span>Perfil</span>
      </a>
    </li>
  </ul>

  <div class="sidebar-footer">
    <form method="POST" action="/logout" class="m-0">
      <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
      <button class="btn btn-secondary w-100" type="submit">
        <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
      </button>
    </form>
  </div>
</aside>
