generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id              String     @id @default(uuid()) // UUID que usa la app como token
  username        String     @unique
  email           String     @unique
  password        String? // bcrypt (login del panel)
  role            Role       @default(USER)
  token_version   Int        @default(1) // revoca sesiones al hacer logout o cambiar contraseña
  expiration_date DateTime?
  banned          Boolean    @default(false)
  configs_locked  Boolean    @default(false)
  config_version  Int        @default(1)
  theme_version   Int        @default(1)
  app_settings    String? // JSON con ajustes controlados por el panel (ver frontend/user/app)
  active_theme_id Int?
  // Personalización de la APK generada por el panel
  apk_package     String?
  apk_name        String?
  apk_icon        String? // path (uploads/apk/) o dataURL del icono subido
  apk_generated   Boolean  @default(false)
  apk_updated_at  DateTime?
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  active_theme Theme?   @relation("ActiveTheme", fields: [active_theme_id], references: [id], onDelete: SetNull)
  themes       Theme[]  @relation("ThemeOwner")
  categories   Category[]
  servers      Server[]

  @@map("users")
}

model Theme {
  id         Int      @id @default(autoincrement())
  name       String
  html       String
  owner_id   String? // null = tema global
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  owner      User?  @relation("ThemeOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  active_for User[] @relation("ActiveTheme")

  @@index([owner_id])
  @@map("themes")
}

model Category {
  id         Int      @id @default(autoincrement())
  name       String
  color      String   @default("#3B82F6")
  sorter     Int      @default(0)
  status     String   @default("ACTIVE")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user_id    String

  servers Server[]

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@map("categories")
}

model Server {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  category_id Int
  sorter      Int      @default(0)
  status      String   @default("ACTIVE")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tunnel_type Int @default(1)

  // SSH
  ssh_server String?
  ssh_port   String?
  ssh_user   String?
  ssh_pass   String?

  // SSL / payload / proxy
  custom_sni          String?
  proxy_payload       String?
  usar_default_payload Boolean @default(true)
  proxy_ip            String?
  proxy_port          String?
  local_port          String  @default("1080")

  // DNS
  dns_forward   Boolean @default(true)
  dns_resolver1 String?
  dns_resolver2 String?
  udp_forward   Boolean @default(true)
  udp_resolver  String?

  // DNSTT / UDP
  udp_server      String?
  udp_auth        String?
  udp_obfs        String?
  udp_down        String?
  udp_up          String?
  udp_buffer      String?
  udp_port        String?
  udp_sni         String?
  udp_version     String?
  udp_line_input  String?
  config_line_input String?

  // V2Ray
  v2ray_json String?

  // Enhanced mode (V2)
  enhanced Boolean @default(true)

  // CheckUser (URL del servidor SSH: http://IP:PUERTO; la app agrega /check/usuario?deviceId=)
  url_check_user String?

  user_id String

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([category_id])
  @@map("servers")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}
